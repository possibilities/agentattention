{
  "contract": "com.example.plan-approval/v1",
  "requestSchema": {
    "type": "object",
    "required": ["summary", "plan"],
    "properties": {
      "summary": { "type": "string" },
      "plan": { "type": "string" },
      "risks": { "type": "array", "items": { "type": "string" } }
    },
    "additionalProperties": false
  },
  "resolutionSchema": {
    "type": "object",
    "required": ["decision"],
    "properties": {
      "decision": { "enum": ["approve", "reject", "comment"] },
      "comment": { "type": "string" }
    },
    "additionalProperties": false
  }
}
