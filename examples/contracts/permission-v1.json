{
  "contract": "com.example.agent-permission/v1",
  "requestSchema": {
    "type": "object",
    "required": ["action", "consequence"],
    "properties": {
      "action": { "type": "string" },
      "consequence": { "type": "string" },
      "agentRef": { "type": "string" }
    },
    "additionalProperties": false
  },
  "resolutionSchema": {
    "type": "object",
    "required": ["decision"],
    "properties": {
      "decision": { "enum": ["approve", "deny"] },
      "comment": { "type": "string" }
    },
    "additionalProperties": false
  }
}
